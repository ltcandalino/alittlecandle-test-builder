  "narrative": {
    "northStar": "The Teacher's Desk",
    "overview": "The app is a warm desk with sheets of paper on it. The cream page is the desk, and white cards are the sheets. The printed test, shown in the preview, is the most important sheet. Everything on screen exists to get that paper right on the first try. The interface stays calm and lets the work lead. The feel is friendly, personal and crafted: it should read as Leigh's own tool, not a generic test generator.",
    "keyCharacteristics": [
      "Warm cream desk (#f6f4ef), white paper cards, one purple accent.",
      "Serif for headings (paper voice), system sans for controls (tool voice).",
      "Nearly flat: hairline borders and a faint shadow; real shadows only for things that float above (dialogs, toasts).",
      "Plain teacher language; every setting has a one-line hint under it.",
      "The printed-paper styles (Arial headings, #8064A2 lesson purple, #E5DFEC review shading) belong to the printouts and follow her Word templates, not this system."
    ],
    "rules": [
      {
        "name": "The One Voice Rule",
        "body": "Candle Purple is the only accent. If something needs attention and isn't a choice or a next step, it gets amber (caution) or red (danger), never a second accent color.",
        "section": "colors"
      },
      {
        "name": "The Desk Isn't Beige Rule",
        "body": "The cream background is part of the identity. Don't \"fix\" it to gray or white.",
        "section": "colors"
      },
      {
        "name": "The Paper Voice Rule",
        "body": "Serif is for headings only: titles of cards, dialogs and the brand. Controls, labels and body text stay sans.",
        "section": "typography"
      },
      {
        "name": "The Readable Floor Rule",
        "body": "Nothing on screen is smaller than 11px. The 8pt \"Use this space for computations\" lives only on the paper.",
        "section": "typography"
      },
      {
        "name": "The One Panel Rule",
        "body": "A place shows one sub-tab's panel at a time. Related settings live together in that panel, not spread across tabs.",
        "section": "layout"
      },
      {
        "name": "The Paper-On-Desk Rule",
        "body": "At rest, cards only get the Paper shadow. A bigger shadow means \"this floats above your work and will go away\".",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** use Candle Purple (#7851a9) only for selection, focus and the main next step.",
      "**Do** give every setting a label above and a one-line Pencil Gray hint in teacher language.",
      "**Do** use a Georgia headline for each card title, and system sans for everything inside.",
      "**Do** make every Delete red (#b3261e) and require a second click.",
      "**Do** show warnings as amber banners with a button that fixes the problem.",
      "**Do** keep the cream desk (#f6f4ef) behind white cards."
    ],
    "donts": [
      "**Don't** add a second accent color. Green was removed on purpose (2026-11-14).",
      "**Don't** use colored side stripes or top stripes on cards (removed in the design review).",
      "**Don't** bring printout styles (Arial headings, lesson purple #8064A2, review shading #E5DFEC) into the app's screens.",
      "**Don't** put on-screen text under 11px.",
      "**Don't** use big shadows on cards. Big shadows are only for dialogs.",
      "**Don't** use technical words (JSON, sync conflict, CSV) in labels or messages."
    ]
  }
}
